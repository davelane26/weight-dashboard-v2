# Gradle
.gradle/
build/
!gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
.idea/
*.iml
local.properties
captures/

# Kotlin
.kotlin/

# Keystores (never commit signing keys)
# EXCEPTION: debug.keystore is committed intentionally so all builds
# share the same signing cert (see .github/workflows/android-build.yml)
*.jks
*.keystore
!app/debug.keystore

# APKs (built by CI, download from GitHub Actions artifacts)
*.apk
*.aab
