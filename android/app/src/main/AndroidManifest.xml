<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet for POSTing to Cloudflare Worker -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Health Connect permissions (Phase 2: full parity) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_FLOORS_CLIMBED" />

    <!-- v0.3.4 additions: distance today, SpO2, HRV, VO2 Max -->
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_VO2_MAX" />
    <!-- v0.4.4 addition: weight (openScale -> Health Connect -> /weight/patch) -->
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <!-- v0.4.5 additions: body fat %, bone mass (same /weight/patch path) -->
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_BONE_MASS" />

    <!-- Foreground service for reliable 15-min sync + boot restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Android 13+ runtime perm for the ongoing sync notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 13+ exact alarms for the watchdog heartbeat. USE_EXACT_ALARM
         is granted without user prompt for apps like ours (health/calendar/etc.);
         SCHEDULE_EXACT_ALARM is the fallback for older Androids where user
         may need to grant it via Settings > Special app access. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Health Connect discovery: allow the system to see we're a Health Connect client -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".KageApp"
        android:allowBackup="true"
        android:label="Kage Health Bridge"
        android:supportsRtl="true"
        android:theme="@style/Theme.KageHealth"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.KageHealth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect permission-rationale activity.
             Health Connect requires this: when the user goes to review permissions,
             the system launches this activity so we can explain why we need each one. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Foreground sync service. Persistent notification keeps this alive
             even when Samsung's OneUI throttles background work. -->
        <service
            android:name=".SyncService"
            android:foregroundServiceType="dataSync|health"
            android:exported="false" />

        <!-- Restart the sync service on boot / after app update -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Independent AlarmManager heartbeat: fires every 15 min and
             restarts the SyncService if Samsung's Clear All killed it.
             Not tied to any notification, so it survives things that
             the foreground service alone can't. -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false" />

    </application>
</manifest>
