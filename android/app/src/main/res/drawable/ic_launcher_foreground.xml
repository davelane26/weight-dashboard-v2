<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground: simple heart-and-arrow motif. Adaptive icon spec expects
     the important artwork to sit within the inner 66dp of a 108dp canvas.
     Everything outside that inner circle can be masked by launchers. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Heart shape centered -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,72 C54,72 36,60 36,48 C36,42 40,38 46,38 C50,38 52,40 54,42 C56,40 58,38 62,38 C68,38 72,42 72,48 C72,60 54,72 54,72 Z" />
    <!-- Signal-wave arc suggesting network sync -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M42,80 Q54,72 66,80" />
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M38,86 Q54,74 70,86" />
</vector>
